// cell2site.com: the static site in site/, baked into one Worker by scripts/build-site.mjs.
// Deploy with: npx wrangler deploy
{
  "name": "cell2site-site",
  "main": ".wrangler/site-worker.js",
  "compatibility_date": "2026-11-01",
  "build": { "command": "node scripts/build-site.mjs" },
  "workers_dev": true,
  // Both domains serve the site; www.<domain> redirects to the bare domain inside the worker.
  "routes": [
    { "pattern": "cell2site.com/*", "zone_name": "cell2site.com" },
    { "pattern": "www.cell2site.com/*", "zone_name": "cell2site.com" },
    { "pattern": "cell2.site/*", "zone_name": "cell2.site" },
    { "pattern": "www.cell2.site/*", "zone_name": "cell2.site" },
    { "pattern": "cell2.site", "custom_domain": true },
    { "pattern": "www.cell2.site", "custom_domain": true },
    // The old Webflow templates subdomains: redirected to /examples/.
    { "pattern": "template.cell2.site", "custom_domain": true },
    { "pattern": "www.template.cell2.site", "custom_domain": true },
    { "pattern": "template.cell2site.com", "custom_domain": true },
    { "pattern": "www.template.cell2site.com", "custom_domain": true }
  ]
}
